// For format details, see https://aka.ms/devcontainer.json
{
	"name": "Laplusblog",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Next.js の開発サーバー (npm run dev)
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Next.js",
			"onAutoForward": "notify"
		}
	},

	// node_modules を名前付きボリュームに置き、ホスト側(WSL)とのファイル同期を避けて高速化する
	"mounts": [
		"source=laplusblog-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
	],

	// ボリュームは root 所有で作成されるため、node ユーザーに渡してから依存を入れる
	"postCreateCommand": "sudo chown node:node node_modules && npm ci",

	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"3w36zj6.textlint",
				"DavidAnson.vscode-markdownlint",
				"yzhang.markdown-all-in-one",
				"christian-kohler.path-intellisense",
				"christian-kohler.npm-intellisense",
				"formulahendry.auto-rename-tag",
				"mhutchie.git-graph",
				"github.vscode-github-actions",
				"GitHub.copilot-chat",
				"MS-CEINTL.vscode-language-pack-ja",
				"oderwat.indent-rainbow",
				"PKief.material-icon-theme"
			]
		}
	}
}
